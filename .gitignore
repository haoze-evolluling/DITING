# ====================================================================
# Android & Gradle Build Outputs
# ====================================================================
/build/
# 旧版 Kotlin 工程（DITING-Legacy）的 Gradle 产物；新版由 DITING-Flutter/.gitignore 覆盖
DITING-Legacy/**/build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.ap_
*.aab
# Go 隧道引擎 AAR 是构建产物：本地用 DITING-Flutter/tunnel/build_aar.ps1 生成，不入库
*.aar

# ====================================================================
# Desktop & Frontend Build Outputs
# ====================================================================
Desktop/build/bin/
Desktop/build/windows/installer/tmp/
Desktop/frontend/dist/
Desktop/frontend/package.json.md5
Desktop/frontend/wailsjs/
Desktop/flutter_frontend/dist/*
!Desktop/flutter_frontend/dist/.gitkeep
Desktop/flutter_frontend/wailsjs/
node_modules/

# ====================================================================
# Local Configuration & SDK
# ====================================================================
local.properties

# ====================================================================
# Keystores & Signing Credentials
# ====================================================================
*.keystore
*.jks
*.p12
# 唯一例外：证书导入单测的 PKCS#12 素材（口令公开，非真实凭据）。
# 它需保持由真实 OpenSSL 3.x 默认参数导出，才能持续覆盖解析兼容性。
!Desktop/internal/core/testdata/dns-lan.p12
keystore/
DITING-keystore/
secrets/
keystore.properties
signing.properties

# ====================================================================
# Python Cache & Bytecode
# ====================================================================
__pycache__/
*.py[cod]
*$py.class

