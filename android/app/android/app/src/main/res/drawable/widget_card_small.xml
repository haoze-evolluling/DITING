<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2x1) widget card: 32dp radius turns the short strip into a capsule, matching the
     compact pill the launcher settings screen shows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <corners android:radius="32dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_card_stroke" />
</shape>
