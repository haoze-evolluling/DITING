<?xml version="1.0" encoding="utf-8"?>
<!-- Medium (4x2): status pill and power button up top, today's blocked count as the hero figure. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_medium"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_dot_off" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_unprotected"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_toggle_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_power_off"
            android:contentDescription="@string/widget_toggle_desc"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_power_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_blocked_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_value_unknown"
        android:textColor="@color/widget_on_surface"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_blocked_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/widget_blocked_today"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="13sp" />
</LinearLayout>
